# ==============================================================================
# NEHA Assistant - Environment Variables Template (.env.example)
# ==============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Is file ko copy karke naya file banayein jiska naam '.env' ho:
#      PowerShell: Copy-Item .env.example .env
# 2. Groq Console se apni official API key prapt karein:
#      Link: https://console.groq.com/keys
# 3. Niche 'GROQ_API_KEY' mein apni key paste karein (replace placeholder).
#
# SECURITY WARNING:
# Apni real API key chat mein na daalein aur kabhi bhi '.env' file ko Git par commit na karein!
# .gitignore file pehle se configured hai taaki '.env' track na ho.
# ==============================================================================

# Groq API Key (starts with 'gsk_') - Used for both Chat and Whisper STT
GROQ_API_KEY=gsk_your_groq_api_key_here

# Configurable Groq Chat Model (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-20b)
GROQ_MODEL=llama-3.3-70b-versatile

# Maximum conversation turns (user + assistant message pairs) to retain in session memory
MAX_CONVERSATION_TURNS=10

# ==============================================================================
# Speech-to-Text (STT) & Microphone Configuration
# ==============================================================================

# Groq Whisper STT Model (Options: whisper-large-v3-turbo [recommended], whisper-large-v3)
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional STT Language ISO-639-1 code (e.g. hi, en). Leave empty for multilingual auto-detection (best for Hinglish)
GROQ_STT_LANGUAGE=

# Microphone recording duration in seconds (Default: 8, Min: 1, Max: 30)
RECORDING_DURATION=8

# Silence RMS volume threshold (Default: 300). If recording audio RMS is below this, transcript is discarded.
SILENCE_THRESHOLD=300

# Optional Microphone device selection (index number or name substring from '/mic list'). Leave empty for system default.
MIC_DEVICE=Headset (Rockerz 110)

# ==============================================================================
# Text-to-Speech (TTS) Settings
# ==============================================================================

# Spoken voice responses on startup ('true' or 'false')
VOICE_ENABLED=true

# Preferred TTS provider ('sarvam' or 'local')
TTS_PROVIDER=sarvam

# Optional Sarvam AI subscription key for Bulbul TTS (https://sarvam.ai)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=neha
SARVAM_TTS_LANG=hi-IN
SARVAM_TTS_PACE=1.0

# Local Windows SAPI5 Speech Rate (words per minute, default: 175)
VOICE_RATE=175

# ==============================================================================
# Hands-Free & Wake-Word Detection (Local Picovoice Porcupine)
# ==============================================================================
# Picovoice AccessKey (Free tier from https://console.picovoice.ai/)
# Required for on-device wake-word detection without cloud audio streaming.
PICOVOICE_ACCESS_KEY=

# Path to custom-trained .ppn keyword model file for "Hi NEHA" (Windows x86_64)
# Trained via Picovoice Console (Porcupine -> Custom Wake Word -> Platform: Windows)
WAKE_WORD_MODEL_PATH=

# Detection sensitivity float between 0.0 and 1.0 (Default: 0.5)
WAKE_WORD_SENSITIVITY=0.5

# ==============================================================================
# Voice Activity Detection (VAD) Settings
# ==============================================================================
# Silence duration in seconds (hangover) after speech to finalize turn (Default: 1.3s)
VAD_SILENCE_DURATION=1.3

# Follow-up listening window duration in seconds after response completes (Default: 4.5s)
VAD_FOLLOW_UP_TIMEOUT=4.5

# Maximum utterance duration in seconds before automatic cutoff (Default: 20.0s)
VAD_MAX_UTTERANCE_DURATION=20.0

# Timeout in seconds waiting for user to begin speaking (Default: 6.0s)
VAD_SPEECH_START_TIMEOUT=6.0

# Minimum speech duration in seconds to reject transient clicks/taps (Default: 0.45s)
VAD_MIN_SPEECH_DURATION=0.45