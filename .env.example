# ==============================================================================
# NEHA Assistant - Environment Variables Template (.env.example)
# ==============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Is file ko copy karke naya file banayein jiska naam '.env' ho:
#      PowerShell: Copy-Item .env.example .env
# 2. Groq Console se apni official API key prapt karein:
#      Link: https://console.groq.com/keys
# 3. Niche 'GROQ_API_KEY' mein apni key paste karein (replace placeholder).
#
# SECURITY WARNING:
# Apni real API key chat mein na daalein aur kabhi bhi '.env' file ko Git par commit na karein!
# .gitignore file pehle se configured hai taaki '.env' track na ho.
# ==============================================================================

# Groq API Key (starts with 'gsk_')
GROQ_API_KEY=gsk_your_groq_api_key_here

# Configurable Groq Chat Model (e.g. openai/gpt-oss-20b, llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=openai/gpt-oss-20b

# Maximum conversation turns (user + assistant message pairs) to retain in session memory
MAX_CONVERSATION_TURNS=10

# ==============================================================================
#